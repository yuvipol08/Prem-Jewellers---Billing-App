{
  "name": "prem-jewellers-billing",
  "productName": "Prem Jewellers Billing",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first GST billing application for Prem Jewellers, Jalgaon.",
  "author": {
    "name": "Prem Jewellers",
    "email": "billing@premjewellers.local"
  },
  "main": "dist-electron/electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,TSC,ELECTRON -c cyan,yellow,green \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:127.0.0.1:5273 dist-electron/electron/main/index.js && cross-env NODE_ENV=development electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "npm run build:main && node --test tests/unit/*.test.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "test:ui": "npm run build && electron tests/electron/ui.cjs",
    "verify": "npm run typecheck && npm run qa",
    "dist:win:portable": "npm run build && electron-builder --win portable",
    "test:core": "npm run build && electron tests/electron/core.cjs",
    "test:backup": "npm run build && electron tests/electron/backup.cjs",
    "test:security": "npm run build && electron tests/electron/security.cjs",
    "test:perf": "npm run build && electron --js-flags=--expose-gc tests/electron/performance.cjs",
    "qa": "node scripts/run-qa.mjs",
    "test:e2e": "npm run test:core && npm run test:backup && npm run test:security && npm run test:ui",
    "docs": "electron scripts/build-docs.cjs",
    "fonts": "node scripts/embed-fonts.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  }
}
